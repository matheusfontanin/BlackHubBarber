    { "parameters": { "workflowId": "={{ $env.WORKFLOW_SYNC_CALENDAR_CREATE || 'SUBSTITUIR' }}", "options": { "waitForSubWorkflow": true }, "workflowInputs": { "mappingMode": "defineBelow", "value": { "payload": "={{ JSON.stringify({ tenant_id: $json.tenant_id, appointment_id: $('Criar Agendamento').item.json[0]?.id || $('Criar Agendamento').item.json.id }) }}" } } }, "id": "sync-calendar-create", "name": "→ Sync Calendar Create", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.1, "position": [920, 300] }
