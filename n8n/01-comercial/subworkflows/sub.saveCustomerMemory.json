{
  "name": "Commercial — Save Customer Memory (shared)",
  "nodes": [
    { "parameters": {}, "id": "trigger", "name": "Execute Workflow Trigger", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1, "position": [200, 300] },
    { "parameters": { "jsCode": "const input = JSON.parse($input.first().json.payload);\nreturn [{ json: { ...input, memory_type: input.memory_type || 'note', source: input.source || 'n8n' } }];" }, "id": "parse", "name": "Parse Payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 300] },
    { "parameters": { "method": "POST", "url": "={{ $env.SUPABASE_URL }}/rest/v1/customer_memories", "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" }, { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }, { "name": "Content-Type", "value": "application/json" }, { "name": "Prefer", "value": "return=representation" } ] }, "sendBody": true, "bodyContentType": "json", "jsonBody": "={\n  \"tenant_id\": \"{{ $json.tenant_id }}\",\n  \"client_id\": \"{{ $json.client_id }}\",\n  \"memory_type\": \"{{ $json.memory_type }}\",\n  \"content\": {{ JSON.stringify($json.content || '') }},\n  \"source\": \"{{ $json.source }}\"\n}" }, "id": "save-memory", "name": "Salvar Memória", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 300] }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Parse Payload", "type": "main", "index": 0 }]] },
    "Parse Payload": { "main": [[{ "node": "Salvar Memória", "type": "main", "index": 0 }]] }
  }
}
