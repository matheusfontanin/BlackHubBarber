{
  "name": "Commercial — Get Availability (shared)",
  "nodes": [
    { "parameters": {}, "id": "trigger", "name": "Execute Workflow Trigger", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1, "position": [200, 300] },
    { "parameters": { "jsCode": "const input = JSON.parse($input.first().json.payload);\nreturn [{ json: input }];" }, "id": "parse", "name": "Parse Payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 300] },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rpc/rpc_available_slots",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
          { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ tenant_id: $json.tenant_id, service_id: $json.service_id, barber_id: $json.barber_id || null, from: $json.from, to: $json.to }) }}"
      },
      "id": "fetch-availability",
      "name": "Buscar Disponibilidade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ...$('Parse Payload').item.json, availability: $('Buscar Disponibilidade').item.json } }];" },
      "id": "return-availability",
      "name": "Retornar Disponibilidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Parse Payload", "type": "main", "index": 0 }]] },
    "Parse Payload": { "main": [[{ "node": "Buscar Disponibilidade", "type": "main", "index": 0 }]] },
    "Buscar Disponibilidade": { "main": [[{ "node": "Retornar Disponibilidade", "type": "main", "index": 0 }]] }
  }
}
