        "jsCode": "const ctx = $('Parse Payload').item.json;\nconst ai = Array.isArray($('Buscar AI Config').item.json) ? $('Buscar AI Config').item.json[0] : $('Buscar AI Config').item.json || {};\nconst booking = Array.isArray($('Buscar Booking Config').item.json) ? $('Buscar Booking Config').item.json[0] : $('Buscar Booking Config').item.json || {};\nconst services = Array.isArray($('Buscar Servicos').item.json) ? $('Buscar Servicos').item.json : [];\nconst barbers = Array.isArray($('Buscar Barbeiros').item.json) ? $('Buscar Barbeiros').item.json : [];\nconst memories = Array.isArray($('Buscar Memorias').item.json) ? $('Buscar Memorias').item.json : [];\nreturn [{ json: { ...ctx, ai_config: ai, booking_config: booking, services, barbers, customer_memories: memories } }];"
