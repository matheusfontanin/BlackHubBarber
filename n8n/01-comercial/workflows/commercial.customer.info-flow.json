{
  "name": "Commercial — Customer Info Flow",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = JSON.parse($input.first().json.payload);\nreturn [{ json: input }];"
      },
      "id": "parse",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $json;\nconst ai = ctx.ai_settings || {};\nconst tenant = ctx.tenant || {};\nconst services = (ctx.services || []).map(s => `- ${s.name}: R$${s.price} (${s.duration_minutes}min)`).join('\\n');\nconst barbers = (ctx.barbers || []).map(b => `- ${b.name}${b.specialties ? ' (' + b.specialties + ')' : ''}`).join('\\n');\nconst hours = JSON.stringify(tenant.opening_hours || {});\nconst history = (ctx.history || []).map(m => `${m.role}: ${m.content}`).join('\\n');\n\nconst systemPrompt = `Voce e ${ai.assistant_name || 'o Assistente'} da barbearia ${tenant.name || 'nossa barbearia'}.\nTom: ${ai.tone_of_voice || 'profissional'}.\n${ai.business_summary ? 'Sobre nos: ' + ai.business_summary : ''}\n${ai.differentiators ? 'Diferenciais: ' + ai.differentiators : ''}\n\nServicos disponiveis:\n${services || 'Nenhum cadastrado'}\n\nBarbeiros:\n${barbers || 'Nenhum cadastrado'}\n\nHorarios: ${hours}\n\nResponda a pergunta do cliente de forma clara e objetiva. Se ele quiser agendar, diga que pode ajuda-lo.`;\n\nreturn [{ json: { ...ctx, system_prompt: systemPrompt, chat_history: history } }];"
      },
      "id": "build-prompt",
      "name": "Montar Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            { "content": "={{ $json.system_prompt }}", "role": "system" },
            { "content": "=Historico:\n{{ $json.chat_history }}\n\nCliente: {{ $json.message_text }}", "role": "user" }
          ]
        },
        "options": { "temperature": 0.7, "maxTokens": 500 }
      },
      "id": "ai-respond",
      "name": "IA Responder",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Parse Payload').item.json;\nconst reply = $json.text || 'Posso ajudar com mais alguma coisa?';\nreturn [{ json: { ...ctx, reply_text: reply } }];"
      },
      "id": "prepare-reply",
      "name": "Preparar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ conversation_id: $json.conversation_id, tenant_id: $json.tenant.id, role: 'assistant', content: $json.reply_text }) }}",
        "options": {}
      },
      "id": "save-reply",
      "name": "Salvar Resposta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $('Parse Payload').item.json.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $('Parse Payload').item.json.sender_phone_full, text: $json.reply_text }) }}",
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 300]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Parse Payload", "type": "main", "index": 0 }]] },
    "Parse Payload": { "main": [[{ "node": "Montar Prompt", "type": "main", "index": 0 }]] },
    "Montar Prompt": { "main": [[{ "node": "IA Responder", "type": "main", "index": 0 }]] },
    "IA Responder": { "main": [[{ "node": "Preparar Resposta", "type": "main", "index": 0 }]] },
    "Preparar Resposta": { "main": [[{ "node": "Salvar Resposta", "type": "main", "index": 0 }]] },
    "Salvar Resposta": { "main": [[{ "node": "Enviar WhatsApp", "type": "main", "index": 0 }]] }
  }
}
