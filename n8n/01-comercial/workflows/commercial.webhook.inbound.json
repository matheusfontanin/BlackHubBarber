{
  "name": "Commercial — Webhook Inbound",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "blackhub-commercial-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "blackhub-commercial-inbound"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\" }",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 140]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nif (body.event !== 'messages.upsert') return [];\n\nconst msg = body.data;\nif (msg.key?.fromMe) return [];\nif (msg.key?.remoteJid?.endsWith('@g.us')) return [];\n\nconst text = msg.message?.conversation\n  || msg.message?.extendedTextMessage?.text\n  || '';\n\nif (!text.trim()) return [];\n\nconst phone = msg.key.remoteJid\n  .replace('@s.whatsapp.net', '')\n  .replace(/^55/, '');\n\nreturn [{\n  json: {\n    instance_name: body.instance,\n    sender_phone: phone,\n    sender_phone_full: msg.key.remoteJid.replace('@s.whatsapp.net', ''),\n    sender_name: msg.pushName || 'Cliente',\n    message_text: text.trim(),\n    message_id: msg.key.id,\n    timestamp: msg.messageTimestamp\n  }\n}];"
      },
      "id": "normalize",
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tenants?whatsapp_instance=eq.{{ $json.instance_name }}&select=id,name,phone,owner_name,opening_hours,whatsapp_instance&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      },
      "id": "resolve-tenant",
      "name": "Resolver Tenant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "has-tenant",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-tenant",
      "name": "Tenant Encontrado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/clients?tenant_id=eq.{{ $('Resolver Tenant').item.json[0].id }}&phone=like.*{{ $('Normalizar Payload').item.json.sender_phone }}*&select=id,name,phone,email&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      },
      "id": "fetch-client",
      "name": "Buscar Cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "client-exists",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-client",
      "name": "Cliente Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/clients",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{ $('Resolver Tenant').item.json[0].id }}\",\n  \"name\": \"{{ $('Normalizar Payload').item.json.sender_name }}\",\n  \"phone\": \"{{ $('Normalizar Payload').item.json.sender_phone }}\"\n}"
      },
      "id": "create-client",
      "name": "Criar Cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 180]
    },
    {
      "parameters": {
        "jsCode": "const tenant = $('Resolver Tenant').item.json[0];\nconst msg = $('Normalizar Payload').item.json;\n\nlet client;\nconst existing = $('Buscar Cliente').item.json;\nif (existing && existing.length > 0) {\n  client = existing[0];\n} else {\n  const created = $('Criar Cliente').item.json;\n  client = Array.isArray(created) ? created[0] : created;\n}\n\nconst cleanTenantPhone = (tenant.phone || '').replace(/\\D/g, '').slice(-9);\nconst cleanSenderPhone = (msg.sender_phone || '').replace(/\\D/g, '').slice(-9);\nconst isOwner = cleanTenantPhone === cleanSenderPhone;\n\nreturn [{\n  json: {\n    tenant,\n    client,\n    message_text: msg.message_text,\n    sender_phone: msg.sender_phone,\n    sender_phone_full: msg.sender_phone_full,\n    sender_name: msg.sender_name,\n    instance_name: msg.instance_name,\n    message_id: msg.message_id,\n    is_owner: isOwner\n  }\n}];"
      },
      "id": "merge-context",
      "name": "Montar Contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 260]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/conversations?tenant_id=eq.{{ $json.tenant.id }}&client_id=eq.{{ $json.client.id }}&channel=eq.whatsapp&status=in.(open,active,ai_handling)&select=id,status&order=created_at.desc&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      },
      "id": "fetch-conversation",
      "name": "Buscar Conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "conv-exists",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-conversation",
      "name": "Conversa Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2180, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{ $('Montar Contexto').item.json.tenant.id }}\",\n  \"client_id\": \"{{ $('Montar Contexto').item.json.client.id }}\",\n  \"channel\": \"whatsapp\",\n  \"status\": \"ai_handling\"\n}"
      },
      "id": "create-conversation",
      "name": "Criar Conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 180]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Montar Contexto').item.json;\n\nlet conversationId;\nconst existing = $('Buscar Conversa').item.json;\nif (existing && existing.length > 0) {\n  conversationId = existing[0].id;\n} else {\n  const created = $('Criar Conversa').item.json;\n  const c = Array.isArray(created) ? created[0] : created;\n  conversationId = c.id;\n}\n\nreturn [{ json: { ...ctx, conversation_id: conversationId } }];"
      },
      "id": "set-conv-id",
      "name": "Definir Conversa ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2620, 260]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/messages?conversation_id=eq.{{ $json.conversation_id }}&select=role,content&order=created_at.desc&limit=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      },
      "id": "fetch-history",
      "name": "Carregar Histórico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2840, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"conversation_id\": \"{{ $('Definir Conversa ID').item.json.conversation_id }}\",\n  \"tenant_id\": \"{{ $('Definir Conversa ID').item.json.tenant.id }}\",\n  \"role\": \"client\",\n  \"content\": \"{{ $('Montar Contexto').item.json.message_text }}\"\n}"
      },
      "id": "save-message",
      "name": "Salvar Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3060, 260]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Definir Conversa ID').item.json;\nconst history = $('Carregar Histórico').item.json || [];\nconst orderedHistory = Array.isArray(history) ? [...history].reverse() : [];\n\nreturn [{ json: { ...ctx, history: orderedHistory } }];"
      },
      "id": "prepare-route",
      "name": "Preparar Roteamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3280, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "is-owner",
              "leftValue": "={{ $json.is_owner }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "route",
      "name": "Dono ou Cliente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3500, 260]
    },
    {
      "parameters": {
        "workflowId": "={{ $env.WORKFLOW_OWNER_RULE_UPDATE || 'SUBSTITUIR' }}",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": { "payload": "={{ JSON.stringify($json) }}" }
        }
      },
      "id": "call-owner",
      "name": "→ Fluxo Dono",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [3720, 180]
    },
    {
      "parameters": {
        "workflowId": "={{ $env.WORKFLOW_CUSTOMER_ROUTER || 'SUBSTITUIR' }}",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": { "payload": "={{ JSON.stringify($json) }}" }
        }
      },
      "id": "call-customer",
      "name": "→ Router Cliente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [3720, 340]
    }
  ],
