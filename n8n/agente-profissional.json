{
  "name": "BarberFlow — Agente Profissional (Dono)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Executado pelo Agente Mestre",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 400]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Executado pelo Agente Mestre').item.json;\nconst tenantData = input.tenant_data;\n\nconst systemPrompt = `Você é o assistente de gestão da barbearia ${tenantData.name}.\nVocê está conversando com ${input.owner_name}, o dono/responsável, via WhatsApp.\n\nREGRAS IMPORTANTES:\n- Confirme sempre antes de fazer alterações em dados\n- Seja direto e eficiente — o dono está ocupado\n- Use linguagem natural e informal\n- Se a mensagem começar com \"ENSINAR:\", salve como regra na base de conhecimento\n\nCAPACIDADES DISPONÍVEIS:\n- Consultar e modificar agenda\n- Salvar novas regras para a IA (\"ENSINAR: ...\")\n- Ver métricas e relatórios\n- Modificar serviços e preços`;\n\nreturn [{\n  json: {\n    ...input,\n    system_prompt: systemPrompt\n  }\n}];"
      },
      "id": "build-context",
      "name": "Montar contexto do dono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20240620\",\n  \"max_tokens\": 1024,\n  \"system\": {{ JSON.stringify($('Montar contexto do dono').item.json.system_prompt) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($('Executado pelo Agente Mestre').item.json.message_text) }}\n    }\n  ]\n}"
      },
      "id": "call-claude",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [940, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Executado pelo Agente Mestre').item.json.tenant_data.evolution_api_url }}/message/sendText/{{ $('Executado pelo Agente Mestre').item.json.tenant_data.whatsapp_instance_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Executado pelo Agente Mestre').item.json.tenant_data.evolution_api_key }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Executado pelo Agente Mestre').item.json.sender_phone }}\",\n  \"text\": {{ JSON.stringify($json.content[0].text) }},\n  \"delay\": 1500\n}"
      },
      "id": "send-whatsapp",
      "name": "Enviar resposta WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Executado pelo Agente Mestre": {
      "main": [[{ "node": "Montar contexto do dono", "type": "main", "index": 0 }]]
    },
    "Montar contexto do dono": {
      "main": [[{ "node": "Claude API", "type": "main", "index": 0 }]]
    },
    "Claude API": {
      "main": [[{ "node": "send-whatsapp", "type": "main", "index": 0 }]]
    }
  }
}
